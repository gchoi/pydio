# ––––––––––––––––––––––––––––––––––––––
# –––––––––––––--  PYDIO  –––––––––––––-
# ––––––––––––––––––––––––––––––––––––––

# Tells Pydio to bind to the container IP
CELLS_BIND=0.0.0.0:8080

# Tells Pydio the public URL used to access it
CELLS_EXTERNAL=http://0.0.0.0:8080

# Disables SSL generation so you can use plain HTTP
CELLS_NO_TLS=1

# ––––––––––––––––––––––––––––––––––––––
# –––––––––––––  DATABASE  –––––––––––––
# ––––––––––––––––––––––––––––––––––––––

MYSQL_DATABASE: cells
MYSQL_USER: pydio
MYSQL_ROOT_PASSWORD: P@ssw0rd
MYSQL_PASSWORD: P@ssw0rd
